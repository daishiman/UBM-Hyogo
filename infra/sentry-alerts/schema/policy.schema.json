{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "environment",
    "action_match",
    "filter_match",
    "filters",
    "frequency",
    "notification_interval_minutes",
    "actions",
    "description"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string", "maxLength": 200 },
    "environment": { "type": "string", "enum": ["staging", "production"] },
    "action_match": { "type": "string", "enum": ["all"] },
    "filter_match": { "type": "string", "enum": ["all"] },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": { "type": "string", "enum": ["event", "scope", "runtime", "digest"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_minutes", "threshold"],
      "properties": {
        "window_minutes": { "type": "integer", "minimum": 1 },
        "threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "notification_interval_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 43200
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "workspace_id_env", "tags"],
        "properties": {
          "type": { "type": "string", "enum": ["slack"] },
          "target": { "type": "string", "minLength": 1 },
          "workspace_id_env": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "channel_id_env": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
